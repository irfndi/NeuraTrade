{
  "name": "neuratrade-cli-ts",
  "version": "1.0.0",
  "description": "TypeScript/Effect-TS port of the NeuraTrade gateway CLI",
  "main": "./dist/index.js",
  "scripts": {
    "start": "bun run index.ts",
    "build": "tsc --noEmit && bun build index.ts --outdir ./dist --target bun",
    "build:bun": "bun build index.ts --outdir ./dist --target bun",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "bunx oxlint .",
    "fmt:check": "bunx oxfmt --check .",
    "fmt": "bunx oxfmt",
    "deploy:cf": "alchemy deploy",
    "dev:cf": "alchemy dev",
    "destroy:cf": "alchemy destroy",
    "logs:cf": "alchemy logs",
    "tail:cf": "alchemy tail"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-beta.102",
    "decimal.js": "^10.6.0",
    "effect": "4.0.0-beta.102",
    "ky": "^2.0.2",
    "zod": "^4.4.3",
    "alchemy": "2.0.0-beta.67",
    "@effect/platform-node": "4.0.0-beta.102"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/decimal.js": "^7.4.3",
    "fast-check": "^3.22.0",
    "typescript": "7.0.2"
  },
  "keywords": [
    "neuratrade",
    "cli",
    "effect",
    "bun",
    "gateway"
  ],
  "author": "NeuraTrade",
  "license": "MIT"
}
