{
  "name": "neuratrade-cli-ts",
  "version": "1.0.0",
  "description": "TypeScript/Effect-TS port of the NeuraTrade gateway CLI",
  "main": "./dist/index.js",
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --oxlint",
    "start": "bun run index.ts",
    "build": "tsc --noEmit && bun build index.ts --outdir ./dist --target bun",
    "build:bun": "bun build index.ts --outdir ./dist --target bun",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsrs --noEmit",
    "typecheck:fast": "bunx tsrs --noEmit",
    "lint": "bunx oxlint .",
    "fmt:check": "bunx oxfmt --check .",
    "fmt": "bunx oxfmt",
    "deploy:cf": "alchemy deploy",
    "dev:cf": "alchemy dev",
    "destroy:cf": "alchemy destroy",
    "logs:cf": "alchemy logs",
    "tail:cf": "alchemy tail",
    "autoresearch:once": "bun run autoresearch/run-once.ts",
    "autoresearch:loop": "bun run autoresearch/loop.ts",
    "autoresearch:test": "bun test autoresearch/",
    "typecheck:tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@effect/platform-bun": "4.1.0",
    "alchemy": "2.0.0-beta.84",
    "decimal.js": "^10.6.0",
    "effect": "4.1.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.63.0",
    "@oxlint/plugins": "1.90.0",
    "@types/bun": "1.4.4",
    "fast-check": "^4.10.2",
    "hyparquet": "1.32.0",
    "hyparquet-writer": "0.18.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsrs": "^0.20.1-ts7.1.0-beta",
    "typescript": "7.0.2"
  },
  "keywords": [
    "neuratrade",
    "cli",
    "effect",
    "bun",
    "gateway"
  ],
  "author": "NeuraTrade",
  "license": "MIT",
  "overrides": {
    "sharp": ">=0.35.5"
  }
}
