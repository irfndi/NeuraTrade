{
  "name": "neuratrade-cli-ts",
  "version": "1.0.0",
  "description": "TypeScript/Effect-TS port of the NeuraTrade gateway CLI",
  "main": "./dist/index.js",
  "scripts": {
    "start": "bun run index.ts",
    "build": "tsc --noEmit && bun build index.ts --outdir ./dist --target bun",
    "build:bun": "bun build index.ts --outdir ./dist --target bun",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "bunx oxlint .",
    "fmt:check": "bunx prettier --check .",
    "fmt": "bunx prettier --write ."
  },
  "dependencies": {
    "@effect/cli": "0.75.2",
    "@effect/platform": "0.96.1",
    "@effect/platform-bun": "0.90.0",
    "effect": "3.21.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "prettier": "3.8.4",
    "typescript": "6.0.3"
  },
  "keywords": [
    "neuratrade",
    "cli",
    "effect",
    "bun",
    "gateway"
  ],
  "author": "NeuraTrade",
  "license": "MIT"
}
