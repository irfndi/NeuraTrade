{
  "name": "neuratrade-cli-ts",
  "version": "1.0.0",
  "description": "TypeScript/Effect-TS port of the NeuraTrade gateway CLI",
  "main": "./dist/index.js",
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --oxlint",
    "start": "bun run index.ts",
    "build": "tsc --noEmit && bun build index.ts --outdir ./dist --target bun",
    "build:bun": "bun build index.ts --outdir ./dist --target bun",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "bunx oxlint .",
    "fmt:check": "bunx oxfmt --check .",
    "fmt": "bunx oxfmt",
    "deploy:cf": "alchemy deploy",
    "dev:cf": "alchemy dev",
    "destroy:cf": "alchemy destroy",
    "logs:cf": "alchemy logs",
    "tail:cf": "alchemy tail",
    "autoresearch:once": "bun run autoresearch/run-once.ts",
    "autoresearch:loop": "bun run autoresearch/loop.ts",
    "autoresearch:test": "bun test autoresearch/"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.5",
    "@effect/platform-node": "4.0.5",
    "alchemy": "2.0.0-beta.83",
    "decimal.js": "^10.6.0",
    "effect": "4.0.5",
    "ky": "^2.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@effect/tsgo": "0.54.1",
    "@oxlint/plugins": "1.89.0",
    "@types/bun": "1.4.3",
    "fast-check": "^4.10.2",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "neuratrade",
    "cli",
    "effect",
    "bun",
    "gateway"
  ],
  "author": "NeuraTrade",
  "license": "MIT",
  "overrides": {
    "hono": ">=4.13.7",
    "@hono/node-server": ">=1.19.10",
    "sharp": ">=0.35.5",
    "valibot": ">=1.4.2",
    "lodash": "^4.18.1"
  }
}
