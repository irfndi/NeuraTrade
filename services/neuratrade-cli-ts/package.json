{
  "name": "neuratrade-cli-ts",
  "version": "1.0.0",
  "description": "TypeScript/Effect-TS port of the NeuraTrade gateway CLI",
  "main": "./dist/index.js",
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --oxlint",
    "start": "bun run index.ts",
    "build": "tsc --noEmit && bun build index.ts --outdir ./dist --target bun",
    "build:bun": "bun build index.ts --outdir ./dist --target bun",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "bunx oxlint .",
    "fmt:check": "bunx oxfmt --check .",
    "fmt": "bunx oxfmt",
    "deploy:cf": "alchemy deploy",
    "dev:cf": "alchemy dev",
    "destroy:cf": "alchemy destroy",
    "logs:cf": "alchemy logs",
    "tail:cf": "alchemy tail"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-rc.108",
    "@effect/platform-node": "4.0.0-rc.108",
    "alchemy": "2.0.0-beta.72",
    "decimal.js": "^10.6.0",
    "effect": "4.0.0-rc.108",
    "ky": "^2.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@effect/tsgo": "0.35.0",
    "@oxlint/plugins": "1.77.0",
    "@types/bun": "1.3.14",
    "fast-check": "^4.9.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "keywords": [
    "neuratrade",
    "cli",
    "effect",
    "bun",
    "gateway"
  ],
  "author": "NeuraTrade",
  "license": "MIT",
  "overrides": {
    "hono": ">=4.12.25",
    "@hono/node-server": ">=1.19.10",
    "valibot": ">=1.4.2"
  }
}
