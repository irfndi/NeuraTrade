{
  "name": "telegram-service",
  "version": "1.0.0",
  "description": "Telegram bot service for NeuraTrade",
  "main": "./dist/index.js",
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --oxlint",
    "start": "node ./dist/index.js",
    "start:bun": "bun run index.ts",
    "dev": "npm run build && node --watch ./dist/index.js",
    "dev:bun": "bun --watch index.ts",
    "build": "tsc && mkdir -p dist/",
    "build:bun": "bun build index.ts --outdir ./dist --target bun",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "bunx oxlint .",
    "fmt:check": "bunx oxfmt --check .",
    "fmt": "bunx oxfmt"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@grpc/grpc-js": "^1.14.6",
    "@sentry/bun": "^11.8.0",
    "effect": "4.0.5",
    "grammy": "^1.46.0",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@effect/tsgo": "0.54.1",
    "@oxlint/plugins": "1.89.0",
    "@types/bun": "^1.4.3",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "telegram",
    "grammy",
    "bot",
    "effect",
    "crypto",
    "notifications"
  ],
  "author": "NeuraTrade",
  "license": "MIT"
}
