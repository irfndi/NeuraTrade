{
  "name": "telegram-service",
  "version": "1.0.0",
  "description": "Telegram bot service for NeuraTrade",
  "main": "./dist/index.js",
  "scripts": {
    "start": "node ./dist/index.js",
    "start:bun": "bun run index.ts",
    "dev": "npm run build && node --watch ./dist/index.js",
    "dev:bun": "bun --watch index.ts",
    "build": "tsgo && mkdir -p dist/",
    "build:bun": "bun build index.ts --outdir ./dist --target bun",
    "build:legacy": "tsc && mkdir -p dist/",
    "test": "bun test"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@grpc/grpc-js": "^1.14.3",
    "@sentry/bun": "^10.49.0",
    "effect": "^3.21.1",
    "grammy": "^1.42.0",
    "hono": "^4.12.14"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "@typescript/native-preview": "beta",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "brace-expansion": "5.0.5"
  },
  "keywords": [
    "telegram",
    "grammy",
    "bot",
    "effect",
    "crypto",
    "notifications"
  ],
  "author": "NeuraTrade",
  "license": "MIT"
}
