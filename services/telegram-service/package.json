{
  "name": "telegram-service",
  "version": "1.0.0",
  "description": "Telegram bot service for NeuraTrade",
  "main": "./dist/index.js",
  "scripts": {
    "start": "bun ./dist/index.js",
    "start:bun": "bun run index.ts",
    "dev": "bun run build && bun --watch ./dist/index.js",
    "dev:bun": "bun --watch index.ts",
    "build": "tsgo && bun build index.ts --outdir ./dist --target bun",
    "build:bun": "bun build index.ts --outdir ./dist --target bun",
    "build:legacy": "tsc && bun build index.ts --outdir ./dist --target bun",
    "test": "bun test"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.0",
    "@grpc/grpc-js": "^1.14.3",
    "@sentry/bun": "^10.51.0",
    "effect": "^3.21.2",
    "grammy": "^1.42.0",
    "hono": "^4.12.16"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@typescript/native-preview": "7.0.0-dev.20260503.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "brace-expansion": "5.0.5",
    "protobufjs": "7.5.5"
  },
  "keywords": [
    "telegram",
    "grammy",
    "bot",
    "effect",
    "crypto",
    "notifications"
  ],
  "author": "NeuraTrade",
  "license": "MIT"
}
