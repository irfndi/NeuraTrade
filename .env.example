# NeuraTrade Environment Variables
# Copy this file to .env in the repository root and fill in your actual values

# ============================================================================
# NEURATRADE HOME DIRECTORY (REQUIRED)
# ============================================================================
# Absolute path to NeuraTrade config and data directory
# This is where SQLite DB, Redis data, and logs will be stored
# NOTE: Use an absolute path. Shell shortcuts like ~ are not expanded by all launch scripts.
# Replace /home/youruser with your actual home directory path.
NEURATRADE_HOME=/home/youruser/.neuratrade

# ============================================================================
# HOST PORT MAPPING (REQUIRED)
# ============================================================================
# Single port exposed to host for backend API (5-digit to avoid conflicts)
# Access NeuraTrade at: http://localhost:58080
BACKEND_HOST_PORT=58080

# Application Environment
ENVIRONMENT=development

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
# Comma-separated list of CORS allowed origins. Leave unset to default to http://localhost:3000.
# In production, set to the explicit origins that should be able to call the API (e.g. https://app.example.com,https://admin.example.com).
# Setting this to "*" is NOT recommended and is no longer the default for security reasons.
NEURATRADE_CORS_ALLOWED_ORIGINS=https://app.example.com

# Database Configuration
# --------------------------------------------------------
# SQLite (Default - Recommended for Development)
# WARNING: SQLite has a known startup issue with collector workers (neura-v7e6)
# Consider using PostgreSQL for full functionality until this is resolved.
DATABASE_DRIVER=sqlite
# NOTE: Use an absolute path matching your NEURATRADE_HOME setting above
SQLITE_PATH=/home/youruser/.neuratrade/neuratrade.db

# PostgreSQL (Optional - for production deployments)
# Uncomment and configure these if using PostgreSQL instead
# DATABASE_DRIVER=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USER=postgres
# SECURITY: Change this password in production - never use default passwords
# DATABASE_PASSWORD=your-secure-database-password-here
# DATABASE_DBNAME=neuratrade
# DATABASE_SSLMODE=disable

# PostgreSQL local runtime defaults (optional)
# SECURITY: Use strong passwords in production environments
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-postgres-password-here
POSTGRES_DB=neuratrade

# For Digital Ocean managed database (preferred for production)
# Use this instead of individual database settings above
# Format: postgres://username:password@host:port/dbname?sslmode=require
DATABASE_URL=

# Database connection pool settings (PostgreSQL only)
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=300s
DATABASE_CONN_MAX_IDLE_TIME=60s

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# CCXT Service Configuration
CCXT_SERVICE_URL=http://localhost:3001
CCXT_TIMEOUT=30s
PORT=3001

# Telegram Bot Configuration (services/telegram-service)
# --------------------------------------------------------
# TELEGRAM_BOT_TOKEN: Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# TELEGRAM_WEBHOOK_URL: Public URL for webhook mode (production)
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/v1/telegram/webhook
# TELEGRAM_WEBHOOK_SECRET: Secret to validate incoming webhook requests
# SECURITY: Generate with: openssl rand -base64 32
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here
# TELEGRAM_USE_POLLING: Set to 'true' for development, 'false' for production webhook mode
TELEGRAM_USE_POLLING=true
# TELEGRAM_WEBHOOK_PATH: Path for the webhook endpoint
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
# TELEGRAM_PORT: Port for the Telegram service
TELEGRAM_PORT=3002
# TELEGRAM_API_BASE_URL: URL of the backend-api service for Telegram to call
TELEGRAM_API_BASE_URL=http://localhost:8080
# RUN_TELEGRAM_SERVICE: Enable/disable the Telegram service
RUN_TELEGRAM_SERVICE=true
# TELEGRAM_EXTERNAL_SERVICE: Set to 'true' to use the external TypeScript Telegram service
# When 'true', disables the legacy Go-based Telegram bot
TELEGRAM_EXTERNAL_SERVICE=true

# Security Configuration
# SECURITY: Generate a strong, random JWT secret (minimum 32 characters)
# Use: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
BCRYPT_COST=12

# Admin API Key for securing admin endpoints
# SECURITY: Generate a strong, unique API key for production
# Use: openssl rand -base64 32
ADMIN_API_KEY=your-secure-admin-api-key-here

# Test Environment Variables (for development/testing only)
# These should not be used in production
TEST_JWT_SECRET=test-jwt-secret-for-development-only
TEST_DB_PASSWORD=test-db-password-for-development-only

# External API Keys
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Feature Flags
FEATURE_TELEGRAM_BOT=true
FEATURE_WEB_INTERFACE=true
FEATURES_REAL_TRADING=false
FEATURES_PAPER_TRADING=true

# Monitoring
METRICS_ENABLED=true
METRICS_PORT=9090

# Market Data Configuration
MARKET_DATA_COLLECTION_INTERVAL=30s
MARKET_DATA_BATCH_SIZE=100

# Arbitrage Configuration
ARBITRAGE_MIN_PROFIT_THRESHOLD=0.5
ARBITRAGE_MAX_TRADE_AMOUNT=1000.0
ARBITRAGE_CHECK_INTERVAL=10s

# Technical Analysis Configuration
TA_CALCULATION_INTERVAL=60s

# Autonomous recovery + liveness tuning (drawdown band control)
# Drawdown thresholds (fractions, e.g. 0.30 = 30%)
# Liveness gate
NEURATRADE_LIVENESS_MAX_ATTEMPTS_PER_HOUR=5
# Recovery clean-cycle gate
NEURATRADE_RECOVERY_CLEAN_CYCLES=1
NEURATRADE_RECOVERY_DERISK_ONLY_DRAWDOWN=0.40
NEURATRADE_RECOVERY_MICRO_ENTRY_CAP_PCT=0.50
NEURATRADE_RECOVERY_MICRO_ENTRY_MIN_DRAWDOWN=0.30
# Recent-loss recovery pause gate
NEURATRADE_SCALPING_SYMBOL_LOSS_STREAK_BUDGET=2
# Position concurrency caps. Micro default is intentionally conservative; raise only after
# verifying available collateral, minimum notional, fee drag, and paper/testnet soak results.
NEURATRADE_SCALPING_MAX_CONCURRENT_POSITIONS=3
NEURATRADE_SCALPING_MICRO_MAX_CONCURRENT_POSITIONS=1

# Sizing / minimum notional
# Fixed minimum notional in USDT for futures order sizing; not a fraction.
# 6.0 = 6 USDT.
NEURATRADE_BITGET_FUTURES_MIN_NOTIONAL_USDT=6.0

# ============================================================================
# AI MODEL CONFIGURATION (single-model-first)
# ============================================================================
# Configure one provider/model pair to get started immediately.
# The app will work with a single model; add more for fallback/round-robin later.

# Primary AI provider: openai, anthropic, google, deepseek, minimax, zhipu
AI_PROVIDER=deepseek

# Primary AI model (fetched dynamically from models.dev registry)
AI_MODEL=deepseek-chat

# API key for your primary AI provider (used via models.dev proxy)
AI_API_KEY=

# Base URL for the AI provider API (defaults to provider-specific endpoint, e.g. https://api.deepseek.com/v1)
# Uncomment and set to override the default base URL for your provider
AI_BASE_URL=

# Routing mode: primary (single model), fallback (try next on failure), round_robin
AI_ROUTING_MODE=primary

# Additional AI models (fallback chain) - configure via config.json or environment
# Example: Add an OpenAI fallback when using Anthropic as primary:
# AI_ADDITIONAL_MODELS_0_PROVIDER_ID=openai
# AI_ADDITIONAL_MODELS_0_MODEL_ID=gpt-4o-mini
# AI_ADDITIONAL_MODELS_0_API_KEY=sk-xxx
# AI_ADDITIONAL_MODELS_0_BASE_URL=https://api.openai.com/v1
